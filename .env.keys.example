# Copy to .env.keys and keep real secrets only there.
# .env.keys is loaded after .env and overrides empty placeholder values.

# Hosted query planning.
GEMINI_API_KEY=
GROQ_API_KEY=

# Hosted reranking providers.
VOYAGE_API_KEY=
OPENROUTER_API_KEY=

# Company API keys. Each tenant profile lists the env names under api.key_envs.
GAINR_API_KEY=
# ACME_API_KEY=

# Separate analytics product keys for server-to-server dashboard requests.
# Browser dashboard users authenticate with an analytics login session.
GAINR_ANALYTICS_API_KEY=
# ACME_ANALYTICS_API_KEY=

# Do not put browser-login passwords in this shared container env file.
# Optional operator-owned `.env.analytics.*.credentials` files are Git-ignored,
# mode 0600, and used only by the one-shot credential sync command. Runtime
# authentication continues to use salted hashes in analytics SQLite.

# Protected admin endpoints.
API_ADMIN_KEY=

# Legacy local-development MySQL credentials. Production containers do not
# receive these when the dedicated workload credentials below are configured.
MYSQL_USER=
MYSQL_PASSWORD=

# Dedicated MySQL workload accounts. The deployment provisioner gives search,
# ingestion, analytics, and telemetry only the tables/actions each path uses.
MYSQL_SEARCH_USER=querix_search
MYSQL_SEARCH_PASSWORD=
MYSQL_INGEST_USER=querix_ingest
MYSQL_INGEST_PASSWORD=
MYSQL_TELEMETRY_USER=querix_telemetry
MYSQL_TELEMETRY_PASSWORD=
MYSQL_ANALYTICS_USER=querix_analytics
MYSQL_ANALYTICS_PASSWORD=
MYSQL_ROLE_HOST=%

# Provisioning-only MySQL administrator. This is exposed only to the ephemeral
# database-admin container and is never injected into a long-running service.
MYSQL_ADMIN_USER=
MYSQL_ADMIN_PASSWORD=

# Optional database TLS private-key material paths.
# Prefer GAINR_DB_TLS_MODE=verify-full in production and set these. If the
# provider cannot supply a CA/hostname, use GAINR_DB_TLS_MODE=require in .env
# as the encrypted fallback and leave the certificate paths empty.
GAINR_DB_TLS_CA_FILE=
GAINR_DB_TLS_CERT_FILE=
GAINR_DB_TLS_KEY_FILE=

# PostgreSQL credentials. For Docker's pgvector service, POSTGRES_USER and
# POSTGRES_PASSWORD are consumed by the Postgres image.
POSTGRES_USER=
POSTGRES_PASSWORD=

# Legacy local-development pgvector credentials.
PGVECTOR_USER=
PGVECTOR_PASSWORD=

# Dedicated pgvector workload accounts. PostgreSQL remains the container-only
# administrator; neither long-running API receives its credentials.
PGVECTOR_SEARCH_USER=querix_search
PGVECTOR_SEARCH_PASSWORD=
PGVECTOR_INGEST_USER=querix_ingest
PGVECTOR_INGEST_PASSWORD=
