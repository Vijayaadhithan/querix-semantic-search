ARG PYTHON_IMAGE=python:3.12.13-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.32@sha256:df4cae8f3a96d175e2e5f992e597550000edbe78fdc2594d5cd8de1a217f504c

FROM ${UV_IMAGE} AS uv
FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    PATH=/app/.venv/bin:$PATH \
    ANALYTICS_API_HOST=0.0.0.0 \
    ANALYTICS_API_PORT=8010 \
    ANALYTICS_SNAPSHOT_DB_PATH=/app/storage/analytics/snapshots.sqlite3

WORKDIR /app

COPY --from=uv /uv /usr/local/bin/uv

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app \
    && useradd --system --gid app --create-home app

COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev --group analytics

COPY src/analytics_service ./src/analytics_service
COPY configs/tenants ./configs/tenants

RUN mkdir -p /app/storage/analytics \
    && chown -R app:app /app

USER app
EXPOSE 8010

HEALTHCHECK --interval=5m --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsS http://127.0.0.1:${ANALYTICS_API_PORT}/api/v1/live || exit 1

CMD ["python", "-m", "analytics_service"]
